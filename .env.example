# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Optional: override the diagnosis model (default claude-sonnet-5)
GARAGEPILOT_MODEL=claude-sonnet-5

# Google Cloud project with billing + Places API (New) + Geocoding API enabled.
# Leave blank to run against data/places_fixture.json.
GOOGLE_MAPS_API_KEY=

# Email notifications to garages. Leave SMTP_HOST blank for dry-run (prints to console).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Base URL used in links inside garage emails
APP_BASE_URL=http://localhost:8501
